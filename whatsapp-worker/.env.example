# URL pública del CRM + endpoint del webhook de Baileys
CRM_WEBHOOK_URL=https://tu-crm.vercel.app/api/webhooks/whatsapp-baileys

# Secreto compartido: el worker -> CRM (debe coincidir con BAILEYS_WEBHOOK_SECRET en Vercel)
BAILEYS_WEBHOOK_SECRET=cambiame-por-un-secreto-largo

# Secreto compartido: CRM -> worker, para /send y /qr (debe coincidir con BAILEYS_WORKER_SECRET en Vercel)
BAILEYS_WORKER_SECRET=cambiame-por-otro-secreto-largo

# Carpeta donde Baileys guarda la sesión (debe ser un volumen persistente)
AUTH_DIR=./auth_info

PORT=3001
LOG_LEVEL=info
